# Copy to .env and fill in. Never commit .env.

# API
PORT=4000
NODE_ENV=development
# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI=
JWT_ACCESS_SECRET=
IP_HASH_SALT=
# Origins allowed to call logged-in API routes (comma separated)
DASHBOARD_ORIGINS=http://localhost:3000,http://localhost:3001
# Origin allowed to call public API routes
EMBED_ORIGIN=http://localhost:5173
